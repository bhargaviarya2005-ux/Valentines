<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Valentine Surprise</title>
<style>
body{
  background:#f7c6d0;
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
  font-family:Arial, sans-serif;
}
.card{
  background:#fff;
  padding:30px;
  border-radius:15px;
  text-align:center;
  width:300px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}
button{
  padding:10px 20px;
  border:none;
  border-radius:20px;
  cursor:pointer;
  font-size:16px;
  margin:5px;
  transition:0.3s;
}
#yes{
  background:#ff5c8d;
  color:white;
}
#no{
  background:#ddd;
  position:absolute;
}
</style>
</head>

<body>
<div class="card">
  💌  
  <h3>Arjun, will you be my Valentine?</h3>
  <br>
  <button id="yes" onclick="yesClick()">Yes 💖</button>
  <button id="no" onmouseover="moveNo()">No 🙃</button>
</div>

<script>
function moveNo(){
  const x = Math.random() * 200;
  const y = Math.random() * 200;
  document.getElementById("no").style.transform =
    `translate(${x}px, ${y}px)`;
}
function yesClick(){
  document.body.innerHTML =
  "<h1 style='color:#ff2f68; text-align:center; margin-top:50px;'>YAY 💕 Arjun said YES! 😍</h1>";
}
</script>
</body>
</html>
